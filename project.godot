; Little World Kitchen — an original portrait merge-and-cook game.
config_version=5

[application]
config/name="Little World Kitchen"
config/version="0.2.0"
config/icon="res://assets/app_icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.98, 0.965, 0.929, 1)
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A little kitchen. A world of possibility. Merge, cook, and make yourself at home."

[display]
window/size/viewport_width=540
window/size/viewport_height=1080
window/size/window_width_override=486
window/size/window_height_override=972
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.98, 0.965, 0.929, 1)

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[audio]
driver/enable_input=false
